# Copy to .env. Everything is optional; the defaults work for local use.

# Data and model artifacts
DATA_PATH=data/raw/marketing_campaign.csv
ARTIFACTS_DIR=artifacts
# ARTIFACT_VERSION=          # empty: the version named in artifacts/LATEST

# Training
# N_SEGMENTS=0               # 0: choose k by silhouette among k >= 3
# RANDOM_STATE=42

# AI insights (optional). Without a key the app uses rule-based text.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# LLM_MODEL=gemini-3.8-flash

# Frontend dev server origins allowed by CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
